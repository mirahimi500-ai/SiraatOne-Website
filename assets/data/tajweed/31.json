3ctajweed class=qalaqah\u003eجْ\u003c/tajweed\u003eزِى وَالِدٌ ع\u003ctajweed class=idgham_ghunnah\u003eَن و\u003c/tajweed\u003eَلَدِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e وَلَا مَوْلُودٌ هُوَ جَازٍ ع\u003ctajweed class=idgham_ghunnah\u003eَن و\u003c/tajweed\u003eَالِدِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e شَيْــًٔا‌ۚ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ وَعْدَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ حَ\u003ctajweed class=ikhafa\u003eقٌّ‌ۖ ف\u003c/tajweed\u003eَلَا تَغُرَّ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَكُمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَيَ\u003ctajweed class=slnt\u003eو\u003c/tajweed\u003e\u003ctajweed class=madda_normal\u003eٲ\u003c/tajweed\u003eةُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eدُّنْيَا وَلَا يَغُرَّ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَك\u003ctajweed class=ikhafa_shafawi\u003eُم ب\u003c/tajweed\u003eِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغَر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eرُ \u003cspan class=end\u003e٣٣\u003c/span\u003e","إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهَ عِ\u003ctajweed class=ikhafa\u003eند\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e عِلْمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسَّاعَةِ وَيُنَزِّلُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغَيْثَ وَيَعْلَمُ مَا فِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْحَامِ‌ۖ وَمَا تَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003eرِى نَفْ\u003ctajweed class=idgham_ghunnah\u003eسٌ م\u003c/tajweed\u003eَّاذَا تَكْسِبُ غَ\u003ctajw