","وَلَا بِقَوْلِ كَاهِ\u003ctajweed class=ikhafa\u003eنٍ‌ۚ ق\u003c/tajweed\u003eَلِيل\u003ctajweed class=idgham_ghunnah\u003eاً م\u003c/tajweed\u003eَّا تَذَكَّر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٢\u003c/span\u003e","تَ\u003ctajweed class=ikhafa\u003eنز\u003c/tajweed\u003eِي\u003ctajweed class=idgham_ghunnah\u003eلٌ م\u003c/tajweed\u003eّ\u003ctajweed class=idgham_wo_ghunnah\u003eِن ر\u003c/tajweed\u003eَّبِّ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eلَم\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٣\u003c/span\u003e","وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَقَاو\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eلِ \u003cspan class=end\u003e٤٤\u003c/span\u003e","لَأَخَذْنَا مِنْهُ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْيَم\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنِ \u003cspan class=end\u003e٤٥\u003c/span\u003e","ثُ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eَ لَقَطَعْنَا مِنْهُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْوَت\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٦\u003c/span\u003e","فَمَا مِ\u003ctajweed class=ikhafa\u003eنك\u003c/tajweed\u003e\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eِّنْ أَحَدٍ عَنْهُ حَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eجِز\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٧\u003c/span\u003e","وَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e لَتَذْكِرَ\u003ctajweed class=idgham_wo_ghunnah\u003eةٌ ل\u003c/tajweed\u003eِّلْمُتَّق\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٨\u003c/span\u003e","وَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَا لَنَعْلَمُ أَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ مِ\u003ctajweed class=ikhafa\u003eنك\u003c/tajweed\u003e\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eُّكَذِّب\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٩\u003c/span\u003e","وَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e لَحَسْرَةٌ عَلَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْكَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eفِر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥٠\u003c/span\u003e","وَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e لَحَقُّ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْيَق\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنِ \u003cspan class=end\u003e٥١\u003c/span\u003e","فَسَبِّحْ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eسْمِ رَبِّكَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَظ\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eمِ \u003cspan class=end\u003e٥٢\u003c/span\u003e"]}