h\u003eنّ\u003c/tajweed\u003eَةُ لِلْمُتَّقِينَ غَيْرَ بَع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٣١\u003c/span\u003e","هَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَف\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eظٍ \u003cspan class=end\u003e٣٢\u003c/span\u003e","مَّنْ خَشِىَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eرَّحْمَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eنَ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغَيْبِ وَج\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءَ بِقَلْ\u003ctajweed class=idgham_ghunnah\u003eبٍ م\u003c/tajweed\u003eُّن\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٣٣\u003c/span\u003e","ٱ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003eخُلُوهَا بِسَلَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003e\u003ctajweed class=ikhafa\u003eمٍ‌ۖ ذ\u003c/tajweed\u003e\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ يَوْمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْخُل\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eِ \u003cspan class=end\u003e٣٤\u003c/span\u003e","لَه\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eَّا يَش\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءُونَ فِيهَا وَلَدَيْنَا مَز\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٌ \u003cspan class=end\u003e٣٥\u003c/span\u003e","وَكَمْ أَهْلَكْنَا قَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eلَه\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eِّ\u003ctajweed class=ikhafa\u003eن ق\u003c/tajweed\u003eَرْنٍ هُمْ أَشَدُّ مِنْه\u003ctajweed class=ikhafa_shafawi\u003eُم ب\u003c/tajweed\u003eَ\u003ctajweed class=qalaqah\u003eطْ\u003c/tajweed\u003e\u003ctajweed class=ikhafa\u003eشًا ف\u003c/tajweed\u003eَنَقَّبُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e فِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْبِلَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eدِ هَلْ م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّح\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eصٍ \u003cspan class=end\u003e٣٦\u003c/span\u003e","إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ فِى ذ\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ لَذِكْرَىٰ لِمَ\u003ctajweed class=ikhafa\u003eن ك\u003c/tajweed\u003eَانَ لَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e قَلْبٌ أَوْ أَلْقَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسَّمْعَ وَهُوَ شَه\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٌ \u003cspan class=end\u003e٣٧\u003c/span\u003e","وَلَقَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003e خَلَ\u003ctajweed class=qalaqah\u003eقْ\u003c/tajweed\u003eنَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسَّمَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eو\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eتِ وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّا\u003ctajweed class=idgham_ghunnah\u003eمٍ و\u003c/tajweed\u003eَمَا مَسَّنَا م\u003ctajweed class=idgham_wo_ghunnah\u003eِن ل\u003c/tajweed\u003eُّغ\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٣٨\u003c/span\u003e","فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eلَ طُلُوعِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eشَّمْسِ وَقَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eلَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغُر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eِ \u003cspan class=end\u003e٣٩\u003c/span\u003e","وَمِنَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّيْلِ فَسَبِّحْهُ وَأَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003eبَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eرَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسُّج\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eِ \u003cspan class=end\u003e٤٠\u003c/span\u003e","وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eسْتَمِعْ يَوْمَ يُنَادِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُنَادِ م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّكَا\u003ctajweed class=ikhafa\u003eنٍ ق\u003c/tajweed\u003eَر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٤١\u003c/span\u003e","يَوْمَ يَسْمَعُونَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eصَّيْحَةَ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَقِّ‌ۚ ذ\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ يَوْمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْخُر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eج\u003c/tajweed\u003eِ \u003cspan class=end\u003e٤٢\u003c/span\u003e","إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَا نَحْنُ نُحْى\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e وَنُمِيتُ وَإِلَيْنَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمَص\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eرُ \u003cspan class=end\u003e٤٣\u003c/span\u003e","يَوْمَ تَشَقَّقُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْضُ عَنْهُمْ سِرَا\u003ctajweed class=ikhafa\u003eعًا‌ۚ ذ\u003c/tajweed\u003e\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ حَشْرٌ عَلَيْنَا يَس\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eرٌ \u003cspan class=end\u003e٤٤\u003c/span\u003e","نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ‌ۖ وَم\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e أَ\u003ctajweed class=ikhafa\u003eنت\u003c/tajweed\u003eَ عَلَيْه\u003ctajweed class=ikhafa_shafawi\u003eِم ب\u003c/tajweed\u003eِجَبَّا\u003ctajweed class=ikhafa\u003eرٍ‌ۖ ف\u003c/tajweed\u003eَذَكِّرْ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْقُرْءَانِ م\u003ctajweed class=idgham_ghunnah\u003eَن ي\u003c/tajweed\u003eَخَافُ وَع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eِ \u003cspan class=end\u003e٤٥\u003c/span\u003e"]}