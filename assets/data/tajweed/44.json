n\u003e","يَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003eعُونَ فِيهَا بِكُلِّ فَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eكِهَةٍ ءَامِن\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥٥\u003c/span\u003e","لَا يَذُوقُونَ فِيهَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمَوْتَ إِلَّا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمَوْتَةَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأُولَىٰ‌ۖ وَوَقَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُمْ عَذَابَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْجَح\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eمِ \u003cspan class=end\u003e٥٦\u003c/span\u003e","فَضْل\u003ctajweed class=idgham_ghunnah\u003eاً م\u003c/tajweed\u003eّ\u003ctajweed class=idgham_wo_ghunnah\u003eِن ر\u003c/tajweed\u003eَّبِّكَ‌ۚ ذ\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ هُوَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْفَوْزُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَظ\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eمُ \u003cspan class=end\u003e٥٧\u003c/span\u003e","فَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَمَا يَسَّرْنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥٨\u003c/span\u003e","فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eرْتَقِ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003e إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَه\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eُّرْتَقِب\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥٩\u003c/span\u003e"]}