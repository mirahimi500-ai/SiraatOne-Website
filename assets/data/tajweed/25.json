d\u003eسَّوْءِ‌ۚ أَفَلَمْ يَكُونُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَرَوْنَهَا‌ۚ بَلْ كَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e لَا يَرْجُونَ نُشُورًا \u003cspan class=end\u003e٤٠\u003c/span\u003e","وَإِذَا رَأَوْكَ إ\u003ctajweed class=idgham_ghunnah\u003eِن ي\u003c/tajweed\u003eَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eذَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذِى بَعَثَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ رَسُولاً \u003cspan class=end\u003e٤١\u003c/span\u003e","إِ\u003ctajweed class=ikhafa\u003eن ك\u003c/tajweed\u003eَادَ لَيُضِلُّنَا عَنْ ءَالِهَتِنَا لَوْل\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e أَ\u003ctajweed class=ikhafa\u003eن ص\u003c/tajweed\u003eَبَرْنَا عَلَيْهَا‌ۚ وَسَوْفَ يَعْلَمُونَ حِينَ يَرَوْنَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَذَابَ مَنْ أَضَلُّ سَبِيلاً \u003cspan class=end\u003e٤٢\u003c/span\u003e","أَرَءَيْتَ مَنِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eتَّخَذَ إِلَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e هَوَ\u003ctajweed class=madda_normal\u003eٮٰ\u003c/tajweed\u003eهُ أَفَأَ\u003ctajweed class=ikhafa\u003eنت\u003c/tajweed\u003eَ تَكُونُ عَلَيْهِ وَكِيلاً \u003cspan class=end\u003e٤٣\u003c/span\u003e","أَمْ تَحْسَبُ أَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ‌ۚ إِنْ هُمْ إِلَّا كَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَنْعَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eمِ‌ۖ بَلْ هُمْ أَضَلُّ سَبِيلاً \u003cspan class=end\u003e٤٤\u003c/span\u003e","أَلَمْ تَرَ إِلَىٰ رَبِّكَ كَيْفَ مَدَّ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eظِّلَّ وَلَوْ ش\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003e