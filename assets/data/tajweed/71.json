03ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْكَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eفِرِينَ دَيَّارًا \u003cspan class=end\u003e٢٦\u003c/span\u003e","إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَكَ إِ\u003ctajweed class=ikhafa\u003eن ت\u003c/tajweed\u003eَذَرْهُمْ يُضِلُّو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e عِبَادَكَ وَلَا يَلِد\u003ctajweed class=madda_obligatory\u003eُوٓ\u003c/tajweed\u003e\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e إِلَّا فَاجِ\u003ctajweed class=ikhafa\u003eرًا ك\u003c/tajweed\u003eَفَّارًا \u003cspan class=end\u003e٢٧\u003c/span\u003e","رَّبِّ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eغْفِرْ لِى وَلِو\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِدَىَّ وَلِمَ\u003ctajweed class=ikhafa\u003eن د\u003c/tajweed\u003eَخَلَ بَيْتِىَ مُؤْمِ\u003ctajweed class=idgham_ghunnah\u003eنًا و\u003c/tajweed\u003eَلِلْمُؤْمِنِينَ وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُؤْمِنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eتِ وَلَا تَزِدِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eظَّ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eلِمِينَ إِلَّا تَبَارَۢا \u003cspan class=end\u003e٢٨\u003c/span\u003e"]}