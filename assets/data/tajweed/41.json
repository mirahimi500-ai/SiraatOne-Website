","فَأَرْسَلْنَا عَلَيْهِمْ رِي\u003ctajweed class=ikhafa\u003eحًا ص\u003c/tajweed\u003eَرْصَ\u003ctajweed class=ikhafa\u003eرًا ف\u003c/tajweed\u003e\u003ctajweed class=madda_obligatory\u003eِىٓ\u003c/tajweed\u003e أَيَّا\u003ctajweed class=idgham_ghunnah\u003eمٍ ن\u003c/tajweed\u003eَّحِسَا\u003ctajweed class=idgham_wo_ghunnah\u003eتٍ ل\u003c/tajweed\u003eِّنُذِيقَهُمْ عَذَابَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْخِزْىِ فِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَيَ\u003ctajweed class=slnt\u003eو\u003c/tajweed\u003e\u003ctajweed class=madda_normal\u003eٲ\u003c/tajweed\u003eةِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eدُّنْيَا‌ۖ وَلَعَذَابُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَخِرَةِ أَخْزَىٰ‌ۖ وَهُمْ لَا يُ\u003ctajweed class=ikhafa\u003eنص\u003c/tajweed\u003eَر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e١٦\u003c/span\u003e","وَأَ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eَا ثَمُودُ فَهَدَيْنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُمْ فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eسْتَحَبُّو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَمَىٰ عَلَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْهُدَىٰ فَأَخَذَتْهُمْ صَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eعِقَةُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَذَابِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْهُونِ بِمَا كَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَكْسِب\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e١٧\u003c/span\u003e","وَنَجَّيْنَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذِينَ ءَامَنُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e وَكَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَتَّق\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e١٨\u003c/span\u003e","وَيَوْمَ يُحْشَرُ أَعْد\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ إِلَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003e\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَارِ فَهُمْ يُوزَع\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e١٩\u003c/span\u003e","حَتَّ\u003ctajweed class=madda_obligatory\u003eىٰٓ\u003c/tajweed\u003e إِذَا مَا ج\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءُوهَا شَهِدَ عَلَيْهِمْ سَمْعُهُمْ وَأَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eصَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eرُهُمْ وَجُلُودُه\u003ctajweed class=ikhafa_shafawi\u003eُم ب\u003c/tajweed\u003eِمَا كَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَعْمَل\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٢٠\u003c/span\u003e","وَقَالُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e لِجُلُودِهِمْ لِمَ شَهِ\u003ctajweed class=idgham_mutajanisayn\u003eد\u003c/tajweed\u003eتُّمْ عَلَيْنَا‌ۖ قَال\u003ctajweed class=madda_obligatory\u003eُوٓ\u003c/tajweed\u003e\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e أَ\u003ctajweed class=ikhafa\u003eنط\u003c/tajweed\u003eَقَنَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذ\u003ctajweed class=madda_obligatory\u003eِىٓ\u003c/tajweed\u003e أَ\u003ctajweed class=ikhafa\u003eنط\u003c/tajweed\u003eَقَ كُلَّ ش\u003ctajweed class=idgham_ghunnah\u003eَىْءٍ و\u003c/tajweed\u003eَهُوَ خَلَقَكُمْ أَوَّلَ مَرَّ\u003ctajweed class=idgham_ghunnah\u003eةٍ و\u003c/tajweed\u003eَإِلَيْهِ تُرْجَع\u003ctajweed class=madda_permissi