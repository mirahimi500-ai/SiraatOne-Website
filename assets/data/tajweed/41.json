003ctajweed class=slnt\u003eوْ\u003c/tajweed\u003eلَ\u003ctajweed class=madda_obligatory\u003eـٰٓ\u003c/tajweed\u003eئِكَ يُنَادَوْنَ م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّكَا\u003ctajweed class=iqlab\u003eنِۭ ب\u003c/tajweed\u003eَع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٤٤\u003c/span\u003e","وَلَقَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003e ءَاتَيْنَا مُوسَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْكِتَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eبَ فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eخْتُلِفَ فِيهِ‌ۗ وَلَوْلَا كَلِمَ\u003ctajweed class=ikhafa\u003eةٌ س\u003c/tajweed\u003eَبَقَتْ م\u003ctajweed class=idgham_wo_ghunnah\u003eِن ر\u003c/tajweed\u003eَّبِّكَ لَقُضِىَ بَيْنَهُمْ‌ۚ وَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُمْ لَفِى شَ\u003ctajweed class=idgham_ghunnah\u003eكٍّ م\u003c/tajweed\u003eِّنْهُ مُر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٤٥\u003c/span\u003e","مَّنْ عَمِلَ صَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eلِ\u003ctajweed class=ikhafa\u003eحًا ف\u003c/tajweed\u003eَلِنَفْسِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e‌ۖ وَمَنْ أَس\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءَ فَعَلَيْهَا‌ۗ وَمَا رَبُّكَ بِظَلَّ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003e\u003ctajweed class=idgham_wo_ghunnah\u003eمٍ ل\u003c/tajweed\u003eِّلْعَب\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eِ \u003cspan class=end\u003e٤٦\u003c/span\u003e","۞ إِلَيْهِ يُرَدُّ عِلْمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسَّاعَةِ‌ۚ وَمَا تَخْرُجُ مِ\u0