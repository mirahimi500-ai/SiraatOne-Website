3eِي\u003c/tajweed\u003eرِ \u003cspan class=end\u003e٤٥\u003c/span\u003e","۞ قُلْ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَم\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e أَعِظُك\u003ctajweed class=ikhafa_shafawi\u003eُم ب\u003c/tajweed\u003eِو\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eحِدَةٍۖ أَ\u003ctajweed class=ikhafa\u003eن ت\u003c/tajweed\u003eَقُومُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e لِلَّهِ مَثْنَىٰ وَفُر\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eدَىٰ ثُ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eَ تَتَفَكَّرُو\u003ctajweed class=slnt\u003eاْۚ\u003c/tajweed\u003e مَا بِصَاحِبِك\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eِّ\u003ctajweed class=ikhafa\u003eن ج\u003c/tajweed\u003eِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَةٍۚ إِنْ هُوَ إِلَّا نَذِي\u003ctajweed class=idgham_wo_ghunnah\u003eرٌ ل\u003c/tajweed\u003eَّك\u003ctajweed class=ikhafa_shafawi\u003eُم ب\u003c/tajweed\u003eَيْنَ يَدَىْ عَذَا\u003ctajweed class=ikhafa\u003eبٍ ش\u003c/tajweed\u003eَد\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٤٦\u003c/span\u003e","قُلْ مَا سَأَلْتُك\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eِّنْ أَ\u003ctajweed class=qalaqah\u003eجْ\u003c/tajweed\u003e\u003ctajweed class=ikhafa\u003eرٍ ف\u003c/tajweed\u003eَهُوَ لَكُمْۖ إِنْ أَ\u003ctajweed class=qalaqah\u003eجْ\u003c/tajweed\u003eرِىَ إِلَّا عَلَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِۖ وَهُوَ عَلَىٰ كُلِّ ش\u003ctajweed class=ikhafa\u003eَىْءٍ ش\u003c/tajweed\u003eَه\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٌ \u003cspan class=end\u003e٤٧\u003c/span\u003e","قُلْ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ رَبِّى يَ\u003ctajweed class=qalaqah\u003eقْ\u003c/tajweed\u003eذِفُ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَقِّ عَلَّ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغُي\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eِ \u003cspan class=end\u003e٤٨\u003c/span\u003e","قُلْ ج\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَقُّ وَمَا يُ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eدِئُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْبَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eطِلُ وَمَا يُع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eُ \u003cspan class=end\u003e٤٩\u003c/span\u003e","قُلْ إِ\u003ctajweed class=ikhafa\u003eن ض\u003c/tajweed\u003eَلَلْتُ فَإِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَم\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e أَضِلُّ عَلَىٰ نَفْسِىۖ وَإِنِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eهْتَدَيْتُ فَبِمَا يُوح\u003ctajweed class=madda_obligatory\u003eِىٓ\u003c/tajweed\u003e إِلَىَّ رَبّ\u003ctajweed class=madda_obligatory\u003eِىٓۚ\u003c/tajweed\u003e إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e سَمِي\u003ctajweed class=ikhafa\u003eعٌ ق\u003c/tajweed\u003eَر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٌ \u003cspan class=end\u003e٥٠\u003c/span\u003e","وَلَوْ تَرَ\u003ctajweed class=madda_obligatory\u003eىٰٓ\u003c/tajweed\u003e إِذْ فَزِعُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e فَلَا فَوْتَ وَأُخِذُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّكَا\u003ctajweed class=ikhafa\u003eنٍ ق\u003c/tajweed\u003eَر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٥١\u003c/span\u003e","وَقَال\u003ctajweed class=madda_obligatory\u003eُوٓ\u003c/tajweed\u003e\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e ءَامَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَا بِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e وَأَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَىٰ لَهُمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eتَّنَاوُشُ م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّكَا\u003ctajweed class=iqlab\u003eنِۭ ب\u003c/tajweed\u003eَع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٥٢\u003c/span\u003e","وَقَ\u003ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003e كَفَرُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e بِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e مِ\u003ctajweed class=ikhafa\u003eن ق\u003c/tajweed\u003eَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eلُۖ وَيَ\u003ctajweed class=qalaqah\u003eقْ\u003c/tajweed\u003eذِفُونَ بِ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغَيْبِ م\u003ctajweed class=idgham_ghunnah\u003eِن م\u003c/tajweed\u003eَّكَا\u003ctajweed class=iqlab\u003eنِۭ ب\u003c/tajweed\u003eَع\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eد\u003c/tajweed\u003eٍ \u003cspan class=end\u003e٥٣\u003c/span\u003e","وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِه\u003ctajweed class=idgham_shafawi\u003eِم م\u003c/tajweed\u003eِّ\u003ctajweed class=ikhafa\u003eن ق\u003c/tajweed\u003eَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eلُۚ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُمْ كَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e فِى شَ\u003ctajweed class=idgham_ghunnah\u003eكٍّ م\u003c/tajweed\u003eُّر\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003e\u003ctajweed class=qalaqah\u003eب\u003c/tajweed\u003eِۭ \u003cspan class=end\u003e٥٤\u003c/span\u003e"]}