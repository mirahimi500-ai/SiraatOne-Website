3c/tajweed\u003eلْمَغْفِرَةِ‌ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَ\u003ctajweed class=ikhafa\u003eنش\u003c/tajweed\u003eَأَك\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eِّنَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْضِ وَإِذْ أَ\u003ctajweed class=ikhafa\u003eنت\u003c/tajweed\u003eُمْ أَجِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ\u003ctajweed class=ikhafa\u003eةٌ ف\u003c/tajweed\u003eِى بُطُونِ أُ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eَهَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eتِكُمْ‌ۖ فَلَا تُزَكّ\u003ctajweed class=madda_obligatory\u003eُوٓ\u003c/tajweed\u003e\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e أَ\u003ctajweed class=ikhafa\u003eنف\u003c/tajweed\u003eُسَكُمْ‌ۖ هُوَ أَعْلَمُ بِمَنِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eتَّقَىٰٓ \u003cspan class=end\u003e٣٢\u003c/span\u003e","أَفَرَءَيْتَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذِى تَوَلَّىٰ \u003cspan class=end\u003e٣٣\u003c/span\u003e","وَأَعْطَىٰ قَلِيل\u003ctajweed class=idgham_ghunnah\u003eاً و\u003c/tajweed\u003eَأَكْدَىٰٓ \u003cspan class=end\u003e٣٤\u003c/span\u003e","أَعِ\u003ctajweed class=ikhafa\u003eند\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e عِلْمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْغَيْبِ فَهُوَ يَرَىٰٓ \u003cspan class=end\u003e٣٥\u003c/span\u003e","أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ \u003cspan class=end\u003e٣٦\u003c/span\u003e","وَإِ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eر\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eهِيمَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذِى وَفَّىٰٓ \u003cspan class=end\u003e٣٧\u003c/span\u003e","أَلَّا تَزِرُ وَازِرَ\u003ctajweed class=idgham_ghunnah\u003eةٌ و\u003c/tajweed\u003eِزْرَ أُخْرَىٰ \u003cspan class=end\u003e٣٨\u003c/span\u003e","وَأ\u003ctajweed class=idgham_wo_ghunnah\u003eَن ل\u003c/tajweed\u003eَّيْسَ لِلْإِ\