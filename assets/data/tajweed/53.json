eطْ\u003c/tajweed\u003eغَىٰ \u003cspan class=end\u003e٥٢\u003c/span\u003e","وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُؤْتَفِكَةَ أَهْوَىٰ \u003cspan class=end\u003e٥٣\u003c/span\u003e","فَغَشَّ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهَا مَا غَشَّىٰ \u003cspan class=end\u003e٥٤\u003c/span\u003e","فَبِأَىِّ ءَال\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءِ رَبِّكَ تَتَمَارَىٰ \u003cspan class=end\u003e٥٥\u003c/span\u003e","هَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eذَا نَذِي\u003ctajweed class=idgham_ghunnah\u003eرٌ م\u003c/tajweed\u003eِّنَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003e\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eُذُرِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأُولَىٰٓ \u003cspan class=end\u003e٥٦\u003c/span\u003e","أَزِفَتِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَزِفَةُ \u003cspan class=end\u003e٥٧\u003c/span\u003e","لَيْسَ لَهَا مِ\u003ctajweed class=ikhafa\u003eن د\u003c/tajweed\u003eُونِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ كَاشِفَةٌ \u003cspan class=end\u003e٥٨\u003c/span\u003e","أَفَمِنْ هَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eذَا \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَدِيثِ تَعْجَب\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥٩\u003c/span\u003e","وَتَضْحَكُونَ وَلَا تَ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eك\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٦٠\u003c/span\u003e","وَأَ\u003ctajweed class=ikhafa\u003eنت\u003c/tajweed\u003eُمْ سَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eمِد\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٦١\u003c/span\u003e","فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eسْجُدُو\