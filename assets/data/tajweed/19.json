=laam_shamsiyah\u003eل\u003c/tajweed\u003eظَّ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eلِمُونَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْيَوْمَ فِى ضَلَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003e\u003ctajweed class=idgham_ghunnah\u003eلٍ م\u003c/tajweed\u003eُّب\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنٍ \u003cspan class=end\u003e٣٨\u003c/span\u003e","وَأَ\u003ctajweed class=ikhafa\u003eنذ\u003c/tajweed\u003eِرْهُمْ يَوْمَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْحَسْرَةِ إِذْ قُضِىَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَمْرُ وَهُمْ فِى غَفْلَ\u003ctajweed class=idgham_ghunnah\u003eةٍ و\u003c/tajweed\u003eَهُمْ لَا يُؤْمِن\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٣٩\u003c/span\u003e","إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَا نَحْنُ نَرِثُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْضَ وَمَنْ عَلَيْهَا وَإِلَيْنَا يُرْجَع\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤٠\u003c/span\u003e","وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eذْكُرْ فِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْكِتَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eبِ إِ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eر\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eهِيمَ‌ۚ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e كَانَ صِدِّي\u003ctajweed class=idgham_ghunnah\u003eقًا ن\u003c/tajweed\u003eَّبِيًّا \u003cspan class=end\u003e٤١\u003c/span\u003e","إِذْ قَالَ لِأَبِيهِ يَ\u003ctajweed class=madda_obligatory\u003eـٰٓ\u003c/tajweed\u003eأَبَتِ لِمَ تَعْبُدُ مَا لَا يَسْمَعُ وَلَا يُ\u003ctajweed class=qalaqah\u003eبْ\u003c/tajweed\u003eصِرُ وَلَا يُغْنِى عَ\u003ctajweed class=ikhafa\u003eنك\u003c/tajweed\u003eَ شَيْــًٔا \u003