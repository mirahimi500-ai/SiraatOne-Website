{"n":63,"ar":["إِذَا ج\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءَكَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eفِقُونَ قَالُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e نَشْهَدُ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَكَ لَرَسُولُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ‌ۗ وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ يَعْلَمُ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَكَ لَرَسُولُهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ يَشْهَدُ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eفِقِينَ لَكَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eذِب\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e١\u003c/span\u003e","ٱتَّخَذ\u003ctajweed class=madda_obligatory\u003eُوٓ\u003c/tajweed\u003e\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e أَيْمَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eنَهُمْ جُ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ\u003ctajweed class=ikhafa\u003eةً ف\u003c/tajweed\u003eَصَدُّو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e عَ\u003ctajweed class=ikhafa\u003eن س\u003c/tajweed\u003eَبِيلِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ‌ۚ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُمْ س\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءَ مَا كَانُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَعْمَل\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٢\u003c/span\u003e","ذ\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eلِكَ بِأَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُمْ ءَامَنُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e ثُ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eَ كَفَرُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَه\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٣\u003c/span\u003e","۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَ\u003ctajweed class=qalaqah\u003eجْ\u003c/tajweed\u003eسَامُهُمْ‌ۖ وَإ\u003ctajweed class=idgham_ghunnah\u003eِن ي\u003c/tajweed\u003eَقُولُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e تَسْمَعْ لِقَوْلِهِمْ‌ۖ كَأَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَهُمْ خُشُ\u003ctajweed class=idgham_ghunnah\u003eبٌ م\u003c/tajweed\u003eُّسَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَدَ\u003ctajweed class=idgham_ghunnah\u003eةٌ‌ۖ ي\u003c/tajweed\u003eَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ‌ۚ هُمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَدُوُّ فَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eحْذَرْهُمْ‌ۚ قَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eتَلَهُمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ‌ۖ أَ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَىٰ يُؤْفَك\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٤\u003c/span\u003e","وَإِذَا قِيلَ لَهُمْ تَعَالَوْ\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e يَسْتَغْفِرْ لَكُمْ رَسُولُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ لَوَّوْ\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَه\u003ctajweed class=idgham_shafawi\u003eُم م\u003c/tajweed\u003eُّسْتَكْبِر\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٥\u003c/span\u003e","سَو\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ ل\u003ctajweed class=idgham_ghunnah\u003eَن ي\u003c/tajweed\u003eَغْفِرَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهُ لَهُمْ‌ۚ إِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهَ لَا يَهْدِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْقَوْمَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْفَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eسِق\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٦\u003c/span\u003e","هُمُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلَّذِينَ يَقُولُونَ لَا تُ\u003ctajweed class=ikhafa\u003eنف\u003c/tajweed\u003eِقُو\u003ctajweed class=slnt\u003eاْ\u003c/tajweed\u003e عَلَىٰ مَنْ عِ\u003ctajweed class=ikhafa\u003eند\u003c/tajweed\u003eَ رَسُولِ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eللَّهِ حَتَّىٰ يَ\u003ctajweed class=ikhafa\u003eنف\u003c/tajweed\u003eَضُّو\u003ctajweed class=slnt\u003eاْ‌ۗ\u003c/tajweed\u003e وَلِلَّهِ خَز\u003ctajweed class=madda_obligatory\u003eَا\u003c/tajweed\u003eٓئِنُ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003e\u003ctajweed class=laam_shamsiyah\u003eل\u003c/tajweed\u003eسَّمَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eو\u003ctajweed class=madda_normal\u003eَٲ\u003c/tajweed\u003eتِ وَ\u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَرْضِ وَلَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eكِ\u003ctajweed class=ghunnah\u003eنّ\u003c/tajweed\u003eَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eفِقِينَ لَا يَفْقَه\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٧\u003c/span\u003e","يَقُولُونَ لَئ\u003ctajweed class=idgham_wo_ghunnah\u003eِن ر\u003c/tajweed\u003eَّجَعْن\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e إِلَى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْم