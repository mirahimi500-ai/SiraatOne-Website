ctajweed class=qalaqah\u003eدْ\u003c/tajweed\u003eنَا فِيهَا غَيْرَ بَيْ\u003ctajweed class=idgham_ghunnah\u003eتٍ م\u003c/tajweed\u003eِّنَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْمُسْلِم\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنَ \u003cspan class=end\u003e٣٦\u003c/span\u003e","وَتَرَكْنَا فِيه\u003ctajweed class=madda_obligatory\u003eَآ\u003c/tajweed\u003e ءَايَ\u003ctajweed class=idgham_wo_ghunnah\u003eةً ل\u003c/tajweed\u003eِّلَّذِينَ يَخَافُونَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْعَذَابَ \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْأَل\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eمَ \u003cspan class=end\u003e٣٧\u003c/span\u003e","وَفِى مُوسَ\u003ctajweed class=madda_obligatory\u003eىٰٓ\u003c/tajweed\u003e إِذْ أَرْسَلْنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003e\u003ctajweed class=idgham_ghunnah\u003eنٍ م\u003c/tajweed\u003eُّب\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eنٍ \u003cspan class=end\u003e٣٨\u003c/span\u003e","فَتَوَلَّىٰ بِرُكْنِه\u003ctajweed class=madda_normal\u003eِۦ\u003c/tajweed\u003e وَقَالَ سَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eحِرٌ أَوْ مَ\u003ctajweed class=qalaqah\u003eجْ\u003c/tajweed\u003eن\u003ctajweed class=madda_permissible\u003eُو\u003c/tajweed\u003eنٌ \u003cspan class=end\u003e٣٩\u003c/span\u003e","فَأَخَذْنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُ وَجُنُودَهُ\u003ctajweed class=madda_normal\u003eۥ\u003c/tajweed\u003e فَنَبَذْنَ\u003ctajweed class=madda_normal\u003eـٰ\u003c/tajweed\u003eهُمْ فِى \u003ctajweed class=ham_wasl\u003eٱ\u003c/tajweed\u003eلْيَ\u003ctajweed class=ghunnah\u003eمّ\u003c/tajweed\u003eِ وَهُوَ مُل\u003ctajweed class=madda_permissible\u003eِي\u003c/tajweed\u003eمٌ \u003cspan class=end\u003e٤٠\u003c/span\u003e","وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِ